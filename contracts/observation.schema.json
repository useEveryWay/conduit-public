{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Observation.schema.json",
  "title": "Observation",
  "description": "Normalized reading after Conduit binds the device. source.type sensor is physical ingress, simulator is simulator ingress, and replay is replay ingress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "receivedAt",
    "venueId",
    "kind",
    "source",
    "location",
    "value"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "receivedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "venueId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "obstruction.distance"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "deviceId",
        "bootId",
        "deviceSeq"
      ],
      "properties": {
        "type": {
          "enum": [
            "sensor",
            "simulator",
            "replay"
          ]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "bootId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "deviceSeq": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId"
      ],
      "properties": {
        "edgeId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distanceMm",
        "valid"
      ],
      "properties": {
        "distanceMm": {
          "type": "number",
          "minimum": 0
        },
        "valid": {
          "type": "boolean"
        }
      }
    }
  }
}
