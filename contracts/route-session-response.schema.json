{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RouteSessionResponse.schema.json",
  "title": "RouteSessionResponse",
  "description": "routeSessionId is the backend UUID. alias echoes demo-main or null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "routeSessionId",
    "alias",
    "venueId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "routeSessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "alias": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "demo-main",
        null
      ]
    },
    "venueId": {
      "type": "string",
      "minLength": 1
    }
  }
}
