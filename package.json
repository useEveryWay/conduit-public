{
  "name": "conduit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "route": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/compute-route.ts",
    "demo:start": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/demo-start.ts",
    "demo:dev": "CONDUIT_WATCH=1 node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/demo-start.ts",
    "demo:reset": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/demo-reset.ts",
    "demo:block": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/demo-block.ts",
    "demo:clear": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/demo-clear.ts",
    "demo:smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/demo-smoke.ts",
    "solana:smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/solana-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana-program/memo": "^0.15.0",
    "@solana/kit": "^8.3.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@solana/kit-plugin-signer": "^0.19.0",
    "mongodb": "^6.21.0",
    "pg": "^8.23.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
